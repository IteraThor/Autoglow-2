# Ignore virtual environment
venv/

# Ignore configuration and cache files (contains secrets)
config.json
online_signals.jsonl
.sync_status.json

# Ignore PyInstaller builds
build/
dist/

# Ignore Python caches
__pycache__/
*.pyc

# Ignore system/log files
*.log

# Runtime data
backups/
scratch/
config.json.*
.venv/

# Chrome extension signing key (defines this installation's extension ID)
chrome_extension.key

# Agent metadata & skills (kept out of the repository)
.agents/
AGENTS.md
docs/superpowers/

# Tool caches
.ruff_cache/
